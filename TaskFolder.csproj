<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationIcon>Resources\TaskFolder.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Keep the runtime beside the app; do not extract executable libraries to Temp at launch. -->
    <PublishSingleFile>false</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>false</IncludeNativeLibrariesForSelfExtract>
    <AssemblyName>TaskFolder</AssemblyName>
    <RootNamespace>TaskFolder</RootNamespace>
    <Version>1.3.0</Version>
    <Authors>Your Name</Authors>
    <Company>TaskFolder</Company>
    <Product>TaskFolder</Product>
    <Description>Windows application launcher with a tray menu and desktop widget</Description>
    <Copyright>Copyright © 2025</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="PowerMenuSmoke" />
    <InternalsVisibleTo Include="CoreSmoke" />
    <InternalsVisibleTo Include="ShellIntegrationSmoke" />
    <InternalsVisibleTo Include="UiSmoke" />
    <Compile Remove="tests\**\*.cs" />
    <!-- Copy icon file to output directory -->
    <None Update="Resources\TaskFolder.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Resources\Icons\" />
    <Folder Include="Models\" />
    <Folder Include="Services\" />
    <Folder Include="Views\" />
    <Folder Include="Utilities\" />
  </ItemGroup>

</Project>
